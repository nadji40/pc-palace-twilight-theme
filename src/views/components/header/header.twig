<header data-testid="store-header" class="store-header palace-header">
  <div class="palace-announcement">
    <div class="container palace-announcement__inner">
      <p>{{ theme.settings.get('palace_announcement')|default(trans('palace.shipping_message')) }}</p>
      <div class="palace-announcement__tools">
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
          <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="palace-masthead">
    <div class="container palace-masthead__inner">
      <a data-testid="store-header-logo" class="palace-logo" href="{{ store.url }}" aria-label="{{ store.name }}">
        <img fetchpriority="high" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}" width="175" height="72">
        {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% endif %}
      </a>

      <div class="palace-search">
        <salla-search data-testid="store-header-search" inline height="48"></salla-search>
      </div>

      <div class="palace-actions">
        <span class="palace-action palace-action--wishlist">
          <salla-wishlist-summary></salla-wishlist-summary><span>{{ trans('palace.wishlist') }}</span>
        </span>
        <salla-cart-summary data-testid="store-header-cart" class="palace-action palace-action--cart">
          <i slot="icon" class="sicon-shopping-bag"></i>
        </salla-cart-summary>
        <span class="palace-action palace-action--account">
          <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
          <span>{{ trans('palace.account') }}</span>
        </span>
      </div>
    </div>
    <div class="container palace-mobile-search">
      <salla-search inline height="44"></salla-search>
    </div>
  </div>

  <div id="mainnav" class="main-nav-container palace-nav">
    <div class="inner w-full">
      <div class="container palace-nav__inner">
        <a data-testid="store-header-mobile-toggle" class="lg:hidden palace-menu-trigger" href="#mobile-menu" aria-label="{{ trans('palace.categories') }}">
          <i class="sicon-menu"></i>
        </a>
        <span class="palace-nav__label hidden lg:inline-flex"><i class="sicon-menu"></i>{{ trans('palace.categories') }}</span>
        <custom-main-menu></custom-main-menu>
      </div>
    </div>
  </div>
  <div class="palace-nav-extra">
    <div class="container"><a href="{{ link('offers') }}"><i class="sicon-fire"></i>{{ trans('palace.best_offers') }}</a></div>
  </div>
  {% if store.scope %}
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  {% endif %}
</header>
