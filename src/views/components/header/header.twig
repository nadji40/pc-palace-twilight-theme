<div class="header-middle header-middle-ptb-1 d-none d-lg-block" style="background-color: #ffffff">
<div class="container"><div class="header-wrap">
<div class="logo logo-width-1"><a href="{{ store.url }}"><img height="55" width="150" class="main-header-logo logo-light" src="{{ store.logo }}" alt="{{ store.name }}"><img height="55" width="150" class="main-header-logo logo-dark lazyload" src="{{ (palace_img ~ 'lazyloading_img.svg')|asset }}" data-src="{{ logo_dark }}" alt="{{ store.name }}"></a></div>
<div class="header-right">
<div class="search-style-2" id="header-search-wrapper">
<form id="search_form" action="{{ link('search') }}" style="display: flex; align-items: center; overflow: visible; position: relative">
<select id="category-select" class="select-active select2-hidden-accessible" tabindex="-1" aria-hidden="true"><option selected value="">{{ trans('palace.categories') }}</option></select><span class="select2 select2-container select2-container--default" dir="ltr" style="width: 140px;"><span class="selection"><span class="select2-selection select2-selection--single" role="combobox" aria-haspopup="true" aria-expanded="false" tabindex="0"><span class="select2-selection__rendered" role="textbox" aria-readonly="true" title="{{ trans('palace.categories') }}">{{ trans('palace.categories') }}</span><span class="select2-selection__arrow" role="presentation"><b role="presentation"></b></span></span></span><span class="dropdown-wrapper" aria-hidden="true"></span></span>
<input name="q" type="text" class="header-search-input" placeholder="{{ trans('palace.search_placeholder') }}" autocomplete="off">
<div class="dynamic-search-results" id="dynamic-search-results"></div>
<button type="submit" value="Submit" class="search-btn"><img src="{{ (palace_img ~ 'search.png')|asset }}" alt="search"></button>
</form>
</div>
<div class="header-action-right"><div class="header-action-2">
<div class="header-action-icon-2"><a href="{{ link('customer.wishlist') }}">{{ heart_icon|raw }}<span class="pro-count blue fav-products-count d-none">0</span><span class="ml-0 mr-0 lable">{{ trans('palace.wishlist') }}</span></a></div>
<div class="header-action-icon-2 center-content palace-header-cart"><div class="salla-island"><salla-cart-summary><span slot="icon" class="palace-cart-icon">{{ cart_icon|raw }}</span></salla-cart-summary></div><span class="lable">{{ trans('palace.cart') }}</span></div>
<div class="header-action-icon-2 center-content palace-header-user"><div class="salla-island"><salla-user-menu avatar-only show-header show-trigger></salla-user-menu></div></div>
</div></div>
</div>
</div></div>
</div>
<div class="header-bottom header-bottom-bg-color sticky-bar" style="background-color: #ffffff">
<div class="container"><div class="header-wrap header-space-between position-relative">
<div class="order-2 logo logo-width-1 d-block d-lg-none max-lg:mx-0"><a href="{{ store.url }}"><img class="main-header-logo logo-light" src="{{ store.logo }}" alt="{{ store.name }}"><img class="main-header-logo logo-dark lazyload" src="{{ (palace_img ~ 'lazyloading_img.svg')|asset }}" data-src="{{ logo_dark }}" alt="{{ store.name }}"></a></div>
<div class="header-nav d-none d-lg-flex">
<div class="main-categori-wrap d-none d-lg-block">
<a class="categories-button-active" href="#"><span class="fi-rs-apps"></span><span class="et">{{ trans('palace.categories') }}</span><i class="fi-rs-angle-down"></i></a>
<div class="categories-dropdown-wrap categories-dropdown-active-large font-heading" id="selected_categories_inner" data-palace-categories></div>
</div>
<div class="main-menu main-menu-padding-1 main-menu-lh-2 d-none d-lg-block font-heading"><nav><ul data-palace-menu>
<li class="hot-deals">
{{ flame_icon|raw }}
<a href="{{ link('offers') }}">{{ trans('palace.best_offers') }}</a></li>
</ul></nav></div>
</div>
<div class="header-action-icon-2 d-block d-lg-none order-1 max-lg:min-w-[7rem]"><div class="burger-icon burger-icon-white"><span class="burger-icon-top"></span><span class="burger-icon-mid"></span><span class="burger-icon-bottom"></span></div></div>
<div class="flex order-3 header-action-right lg:hidden">
<div class="mobile-search"><a class="header-action-icon center-content md:px-3" href="{{ link('search') }}"><svg width="41" height="41" viewBox="0 0 41 41" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 cursor-pointer"><path d="M18.6666 31.7066C26.0303 31.7066 31.9999 25.737 31.9999 18.3733C31.9999 11.0095 26.0303 5.03992 18.6666 5.03992C11.3028 5.03992 5.33325 11.0095 5.33325 18.3733C5.33325 25.737 11.3028 31.7066 18.6666 31.7066Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M35.3333 35.0399L28.0833 27.7899" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"></path></svg></a></div>
<div class="header-action-2"><div class="header-action-icon-2 palace-header-cart"><div class="salla-island"><salla-cart-summary><span slot="icon" class="palace-cart-icon">{{ cart_icon|raw }}</span></salla-cart-summary></div></div></div>
</div>
</div></div>
</div>
</header>
<div class="mobile-header-active mobile-header-wrapper-style">
<div class="mobile-header-wrapper-inner">
<div class="mobile-header-top">
<div class="mobile-header-logo"><a href="{{ store.url }}"><img class="main-header-logo logo-light lazyload" src="{{ (palace_img ~ 'lazyloading_img.svg')|asset }}" data-src="{{ store.logo }}" alt="{{ store.name }}"><img class="main-header-logo logo-dark lazyload" src="{{ (palace_img ~ 'lazyloading_img.svg')|asset }}" data-src="{{ logo_dark }}" alt="{{ store.name }}"></a></div>
<div class="mobile-menu-close close-style-wrap close-style-position-inherit"><button class="close-style search-close" type="button"><i class="icon-top"></i><i class="icon-bottom"></i></button></div>
</div>
<div class="mobile-header-content-area">
<div style="position: relative;">
{% if is_user %}
<div class="mb-3 single-mobile-header-info"><a href="{{ link('customer.profile') }}"><i class="mr-10 fi fi-rs-user"></i>{{ trans('palace.profile') }}</a></div>
<div class="mb-3 single-mobile-header-info"><a href="{{ link('customer.orders') }}"><i class="mr-10 fi fi-rs-shopping-bag"></i>{{ trans('palace.orders') }}</a></div>
<div class="mb-3 single-mobile-header-info"><a class="logout-ptn" href="#" data-palace-logout><i class="mr-10 fi fi-rs-sign-out"></i>{{ trans('palace.logout') }}</a></div>
{% else %}
<div class="mb-3 single-mobile-header-info"><a href="#" data-palace-login><i class="mr-10 fi fi-rs-sign-in"></i>{{ trans('palace.login') }}</a></div>
{% endif %}
</div>
<div class="mobile-search search-style-3 mobile-header-border"><form action="{{ link('search') }}"><input name="q" type="text" placeholder="{{ trans('palace.search_placeholder') }}"><button type="submit"><i class="fi-rs-search"></i></button></form></div>
<div class="mobile-menu-wrap mobile-header-border">
<nav><ul class="mobile-menu font-heading" data-palace-mobile-menu>
<li data-palace-static><a href="{{ link('products') }}">{{ trans('palace.all_products') }}</a></li>
<li data-palace-static><a href="{{ link('categories') }}">{{ trans('palace.all_categories') }}</a></li>
<li data-palace-static>
{{ flame_icon|raw }}
<a href="{{ link('offers') }}">{{ trans('palace.best_offers') }}</a>
</li>
<li data-palace-static>
<button class="open-fav-modal-mobile" type="button" data-palace-href="{{ link('customer.wishlist') }}">
{{ heart_icon|raw }}			<span class="ml-0 mr-0 lable">{{ trans('palace.wishlist') }}</span>
</button>
</li>
<ul class="mobile-lang-currency" data-palace-static>
{% if store.settings.is_multilingual %}<li class="nt_languages "><span>{{ trans('palace.language') }}</span><div><button type="button" data-palace-localization>{{ trans('palace.switch_language') }}</button></div></li>{% endif %}
<li class="menu-item-has-children nt_currencies">{{ trans('palace.country') }}<button type="button" data-palace-localization><img class="lazyload" src="{{ (palace_img ~ 'lazyloading_img.svg')|asset }}" data-src="{{ (palace_img ~ 'sa.svg')|asset }}" alt=""> {{ theme.settings.get('palace_country_code', 'SA') }}</button></li>
<li class="darkmode-switch-item">{{ trans('palace.dark_mode') }}<button type="button" class="switch-modes" data-palace-dark-mode><i class="bx bxs-sun">{{ sun_icon|raw }}</i><span class="btn-switch"></span><i class="bx bxs-moon">{{ moon_icon|raw }}</i></button></li>
</ul>
</ul></nav>
</div>
<div class="mt-20 mobile-social-icon mb-30"><h6 class="mb-15">{{ trans('palace.follow_us') }}</h6>{% for item in social %}{% if item[1] %}<a href="{{ item[1] }}" target="_blank" rel="noopener"><img src="{{ (palace_img ~ item[2])|asset }}" alt="{{ item[0] }}"></a>{% endif %}{% endfor %}</div>
</div>
</div>
</div>
</div>
