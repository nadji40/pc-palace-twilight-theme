{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component                      | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides               | object[] | list of slides                                                               |
| position                       | int      | Sorting number start from zero                                               |
#}
<section component-id="{{ componentId }}" data-testid="store-home-slider" class="s-block s-block--hero-slider">
  <salla-slider id="main-slider-{{ position }}" type="fullwidth" auto-play pagination static-when-single
                {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}>
    <div slot="items">
      {% for slide in component.slides %}
        <div class="swiper-slide">
          {% if slide.url %}<a href="{{ slide.url }}" aria-label="{{ slide.title|default(store.name) }}">{% endif %}
            <img src="{{ slide.image }}" alt="{{ slide.title|default(store.name) }}"
                 width="1440" height="488" loading="{{ loop.first ? 'eager' : 'lazy' }}"
                 {% if loop.first %}fetchpriority="high"{% endif %}>
          {% if slide.url %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>
  </salla-slider>
</section>
