{#
  PC Palace category tabs (reference: products-tabs): one tab per category, ten products each,
  with a "view all" button under the grid.
  component.title | component.categories[] | component.limit | component.more_text
#}
{% set sid = 'palace-' ~ (position|default(0)) %}
<section main-section-id="{{ sid }}" id="product-tabs-{{ sid }}" class="palace-ref" component-id="{{ componentId }}">
<section class="pb-5 section-padding featured-products-section lazyloaded" section-id="{{ sid }}" data-palace-section="tabs">
<div class="container">
<div class="section-title wow animate__animated animate__fadeIn">
<div class="title"><h3>{{ component.title }}</h3></div>
<div class="tabs-wrapper"><ul class="nav nav-tabs links" id="myTab-{{ sid }}" role="tablist">
{% for category in component.categories %}
{% set tab = {'source': 'categories', 'value': [category.id], 'limit': component.limit ?: 10, 'moreUrl': category.url, 'moreText': component.more_text ?: trans('palace.view_all')} %}
<li class="nav-item" role="presentation"><button class="nav-link {{ loop.first ? 'active' : '' }}" id="nav-tab-{{ sid }}-{{ loop.index0 }}" type="button" role="tab" data-palace-tab="{{ tab|json_encode }}">{{ category.name }}</button></li>
{% endfor %}
</ul></div>
</div>
<div class="tab-content"><div class="tab-pane fade show active min-h-80" role="tabpanel">
<div class="row product-grid-4"></div>
<div class="more-content"></div>
</div></div>
</div>
</section>
</section>
