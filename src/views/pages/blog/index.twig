{#
| Variable                | Type          | Description                 |
|-------------------------|---------------|-----------------------------|
| page                    | object        |                             |
| page.title              | string        |                             |
| page.slug               | string        |                             |
| slides                  | ?Article[]    | @see pages/blog/single.twig |
| articles                | Article[]     |                             |
| categories              | BlogCategory[]|                             |
| category.is_current     | bool          |                             |
| category.name           | string        |                             |
| category.url            | string        |                             |

  PC Palace blog (reference: pcpalace-theme/pages/blog.html), with the Nest article grid.
#}
{% extends "layouts.master" %}
{% block content %}
<div class="palace-ref palace-blog">
{% include 'pages.partials.palace-breadcrumb' with {crumbs: [[page.title ?: trans('palace.blog')]]} %}
<div class="page-content pt-50"><div class="container">
<div class="single-page pr-30 mb-lg-0 mb-sm-5">
<div class="single-header style-2"><h2>{{ page.title ?: trans('palace.blog') }}</h2></div>
{% if categories|length %}
<div class="palace-blog-categories mb-30">{% for category in categories %}<a href="{{ category.url }}" class="btn btn-sm {{ category.is_current ? '' : 'btn-outline' }}">{{ category.name }}</a>{% endfor %}</div>
{% endif %}
<div class="loop-grid pr-30"><div class="row">
{% for article in articles %}
<article class="col-xl-4 col-lg-6 col-md-6 text-center hover-up mb-30 wow animate__animated animate__fadeInUp" data-wow-delay="0.{{ loop.index0 % 3 }}s">
<div class="post-thumb"><a href="{{ article.url }}"><img class="border-radius-15 lazyload" src="{{ 'images/palace/lazyloading_img.svg'|asset }}" data-src="{{ article.has_image ? article.image.url : ('images/placeholder.png'|asset) }}" alt="{{ article.image.alt ?: article.title }}"></a></div>
<div class="entry-content-2">
{% if article.tags|length %}<h6 class="mb-10 font-sm"><a class="entry-meta text-muted" href="{{ (article.tags|first).url }}">{{ (article.tags|first).name }}</a></h6>{% endif %}
<h4 class="post-title mb-15"><a href="{{ article.url }}">{{ article.title }}</a></h4>
{% if article.summary %}<p class="post-exerpt font-sm">{{ article.summary }}</p>{% endif %}
<div class="entry-meta font-xs color-grey mt-10 pb-10"><div><span class="post-on mr-10">{{ article.created_at|date }}</span>{% if article.author.name %}<span class="hit-count has-dot">{{ article.author.name }}</span>{% endif %}</div></div>
</div>
</article>
{% else %}
<p class="text-center">{{ trans('palace.no_articles') }}</p>
{% endfor %}
</div></div>
{% if articles.next_page %}<div class="text-center mb-50"><a class="btn" href="{{ articles.next_page }}">{{ trans('palace.more') }}</a></div>{% endif %}
</div>
</div></div>
</div>
{% endblock %}
