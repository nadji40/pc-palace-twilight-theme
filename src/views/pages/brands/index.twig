{#
| Variable   | Type         | Description                                                |
|------------|--------------|------------------------------------------------------------|
| page       | object       |                                                            |
| page.title | string       |                                                            |
| page.slug  | string       |                                                            |
| brands     | Collection[] | Brands grouped by char, ex:{b:[{'name':'brand1',...},...]} |

  PC Palace brands grid (same cards as reference: pcpalace-theme/pages/categories.html).
#}
{% extends "layouts.master" %}
{% block content %}
<div class="palace-ref palace-brands-page">
{% include 'pages.partials.palace-breadcrumb' with {crumbs: [[page.title ?: trans('palace.brands')]]} %}
<div class="page-content pt-50"><div class="container">
<div class="single-page pr-30 mb-lg-0 mb-sm-5">
<div class="single-header style-2"><h2>{{ page.title ?: trans('palace.brands') }}</h2></div>
<div class="single-content mb-50">
<section class="popular-categories section-padding"><div class="container wow animate__animated animate__fadeIn"><div class="carausel-10-columns-cover position-relative"><div class="carausel-10-columns row">
{% for char, group in brands %}{% for brand in group %}
<div class="col-md-2 col-6"><div class="card-2 bg-9 wow animate__animated animate__fadeInUp" data-wow-delay="0.s"><a href="{{ brand.url }}">
<figure class="img-hover-scale overflow-hidden"><div><img class="lazyload" src="{{ 'images/palace/lazyloading_img.svg'|asset }}" data-src="{{ brand.logo }}" alt="{{ brand.name }}"></div></figure>
<h6 class="truncate">{{ brand.name }}</h6>
</a></div></div>
{% endfor %}{% else %}
<p class="text-center">{{ trans('pages.brands.non_brands') }}</p>
{% endfor %}
</div></div></div></section>
</div>
</div>
</div></div>
</div>
{% endblock %}
