{#
| Variable          | Type                 | Description                                               |
|-------------------|----------------------|-----------------------------------------------------------|
| page              | object               |                                                           |
| page.title        | string               |                                                           |
| page.slug         | string               |                                                           |
| brand             | Brand *              |                                                           |
| brand.id          | int                  |                                                           |
| brand.name        | string               |                                                           |
| brand.url         | string               |                                                           |
| brand.logo        | string               |                                                           |
| brand.banner      | ?string              | Null when is not set, or merchant doesn't want to show it |
| brand.description | string               |                                                           |

  Brand products in the PC Palace listing layout.
#}
{% extends "layouts.master" %}
{% block content %}
{% set title = brand.name %}
{% set sorts = sort_options|default([]) %}
{% set current_sort = sorts|first %}
{% for sort in sorts %}{% if sort.is_selected %}{% set current_sort = sort %}{% endif %}{% endfor %}
{% set config = {'source': 'brands', 'value': brand.id, 'limit': 24, 'sort': current_sort ? current_sort.id : ''} %}
{% set listing_description = brand.description %}
{% set listing_children = [] %}
{% set listing_details_start %}{% hook 'brands:single.details.start' %}{% endset %}
{% set listing_details_end %}{% hook 'brands:single.details.end' %}{% endset %}
{% set listing_items_start %}{% hook 'brands:single.items.start' %}{% endset %}
{% set listing_items_end %}{% hook 'brands:single.items.end' %}{% endset %}
{% include 'pages.partials.palace-listing' %}
{% endblock %}
