{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.barcode                        | ?string                     |                                                                        |
| product.shows_sku                      | bool                        | SKU row belongs on the page (selected, and a value exists somewhere)   |
| product.shows_barcode                  | bool                        | Barcode row belongs on the page (selected, and a value exists)         |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].video_type            | ?string                     | 'video' 'youtube'                                                      |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.brand.id                       | int                         |                                                                        |
| product.brand.url                      | ?string                     |                                                                        |
| product.brand.name                     | ?string                     |                                                                        |
| product.brand.logo                     | ?string                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.tags[].name                    | string                      |                                                                        |
| product.tags[].url                     | string                      |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.notify_availability.channels   | array                       | ex: ['sms', 'email']                                                   |
| product.notify_availability.subscribed | bool                        | Does user subscribed before                                            |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.donation.target_message        | ?string                     | Message if reached to target or target expired                         |
| product.donation.collected_amount      | float                       |                                                                        |
| product.donation.target_amount         | float                       |                                                                        |
| product.donation.target_percent        | float                       |                                                                        |
| product.donation.target_end_date       | ?Date                       |                                                                        |
| product.donation.can_donate            | bool                        | `true` When there is no campaign or (target not reached & not expired) |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        | Is it for  `Food` or `Custom Service` product                          |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |
#}
{% extends "layouts.master" %}
{#
  PC Palace product page (reference: pcpalace-theme/pages/product-detail.html), on Salla's
  product data. Gallery, option lists, quantity, add to cart / buy now, reviews and comments
  are driven by palace-reference.js (product()) through the Salla SDK.
#}
{% block content %}
{% set images = product.images|length ? product.images : [product.image] %}
{% set on_sale = product.is_on_sale and product.regular_price > product.price %}
{% set discount = on_sale ? (product.discount_percentage ? product.discount_percentage|replace({'%': ''})|trim : ((product.regular_price - product.price) / product.regular_price * 100)|round) : 0 %}
{% set stars = product.rating ? product.rating.stars : 0 %}
{% set buttons %}
{% if not product.is_hidden_quantity %}<div class="salla-island palace-qty"><salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="{{ trans('palace.quantity') }}" data-palace-qty></salla-quantity-input></div>{% endif %}
<div class="product-extra-link2">
<button type="button" class="button button-add-to-cart" style="opacity: 1;" data-palace-add-product><i class="fi-rs-shopping-cart"></i><span>{{ trans('palace.add_to_cart_long') }}</span></button>
<button type="button" class="button button-add-to-cart btn-buy-now" style="opacity: 1;" data-palace-buy-now><i class="fi-rs-shopping-bag"></i><span>{{ trans('palace.buy_now') }}</span></button>
</div>
{% endset %}

<div class="s-blocks-wrapper s-before-product-info">{% hook 'product.single.before_product_info' %}</div>

<div class="palace-ref palace-product" data-cart-url="{{ link('cart') }}" data-palace-section="product" data-palace-product="{{ {'id': product.id, 'price': product.price, 'regular': product.regular_price, 'onSale': on_sale}|json_encode }}">
<div class="page-header breadcrumb-wrap"><div class="container"><div class="breadcrumb">
<a href="{{ store.url }}" rel="nofollow"><i class="mr-5 fi-rs-home"></i> {{ trans('palace.home') }}</a>
<span></span>
<a href="{{ link('products') }}" rel="nofollow"> {{ trans('palace.products_title') }}</a>
<span></span> {{ product.name }}
</div></div></div>

<div class="container mb-30"><div class="row"><div class="m-auto col-xl-10 col-lg-12">
<div class="product-detail accordion-detail fancybox_content_wrapper">
<form class="row product mt__40 main-product-form" id="product-form-{{ product.id }}" data-palace-product-form onsubmit="return false">
<input type="hidden" name="id" value="{{ product.id }}">
{% hook 'product:single.form.start' %}
<div class="row mb-50 mt-30">

<div class="col-md-6 col-sm-12 col-xs-12 mb-md-0 mb-sm-5 product-gallery-wrapper">
<div class="d-md-none">
<h1 class="title-detail">{{ product.name }}</h1>
{% if product.promotion_title %}<div class="product-tags single"><span>{{ product.promotion_title }}</span></div>{% endif %}
<div class="product-info-label single"></div>
<div class="product-detail-rating"><div class="product-rate-cover text-end"><div class="product-rate d-inline-block"><div class="product-rating" style="width: {{ stars * 20 }}%"></div></div><span class="font-small ml-5 text-muted  d-inline-block "> ({{ stars|number_format(1) }}) </span></div></div>
</div>
<div class="product-gallery-images"><div><div class="detail-gallery max-w-full" data-palace-gallery-main>
<div class="relative w-full swiper-thumbnail">
<div class="product-image-slider">
<span class="cursor-pointer zoom-icon" data-palace-zoom><i class="fi-rs-search"></i></span>
<div class="swiper mySwiper2" style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff;"><div class="swiper-wrapper">
{% for image in images %}<div class="swiper-slide"><div class="swiper-zoom-container"><figure class="relative w-full pt-[84%]"><img class="absolute inset-0 object-contain w-full h-full" src="{{ image.url }}" alt="{{ image.alt ?: product.name }}"></figure></div></div>{% endfor %}
</div><div class="swiper-button-prev"></div><div class="swiper-button-next"></div></div>
</div>
<div class="swiper mySwiper"><div class="swiper-wrapper">
{% for image in images %}<div class="swiper-slide"><figure class="relative w-full pt-[100%]"><img class="absolute inset-0 object-contain w-full h-full" src="{{ image.url }}" alt="{{ image.alt ?: product.name }}"></figure></div>{% endfor %}
</div></div>
</div>
<div class="lg-react-element "></div>
</div></div></div>
</div>

<div class="col-md-6 col-sm-12 col-xs-12">
<div class="detail-info pr-30 pl-30">
<div class="d-none d-md-block">
{% if on_sale %}<span class="stock-status out-stock" id="sale-tag">{{ discount }}% {{ trans('palace.off') }}</span>{% endif %}
<h2 class="title-detail">{{ product.name }}</h2>
{% if product.promotion_title %}<div class="product-tags single"><span>{{ product.promotion_title }}</span></div>{% endif %}
<div class="product-info-label single"></div>
<div class="product-detail-rating"><div class="product-rate-cover text-end"><div class="product-rate d-inline-block"><div class="product-rating" style="width: {{ stars * 20 }}%"></div></div><span class="font-small ml-5 text-muted  d-inline-block "> ({{ stars|number_format(1) }}) </span></div></div>
</div>
<div class="clearfix product-price-cover"><div class="float-left product-price primary-color">
<span class="current-price text-brand product-price-span" id="product-price-span" data-palace-money="{{ product.price }}" data-palace-live-price></span>
{% if on_sale %}<span id="product-old-price" class="product-old-price"><span class="save-price font-md color3 ml-15">{{ discount }}% {{ trans('palace.off') }}</span><span class="old-price font-md ml-15" data-palace-money="{{ product.regular_price }}" data-palace-live-old></span></span>{% endif %}
</div></div>
{% hook 'product:single.description.start' %}
{% if product.subtitle %}<pre class="short-desc mb-30"><div class="font-sm">{{ product.subtitle|raw }}</div></pre>{% endif %}

{% if product.options|length %}
<div class="attr-detail attr-size "><div class="product-option-container select-view box-view">
{% for option in product.options %}
{% if option.type == 'splitter' %}
<div class="custom-field-separator"></div>
{% elseif option.details|length %}
<div id="product-custom-user-dropdown-fields"><div class="form-group" data-palace-option="{{ option.id }}" data-required="{{ option.required ? 1 : 0 }}" data-multiple="{{ option.type == 'multiple-options' ? 1 : 0 }}" data-name="{{ option.name }}"><div>
<label><span><span class="text-color-primary">{{ option.name }} </span></span></label>
<input type="hidden" name="options[{{ option.id }}]" value="">
<div class="scrollableList"><div class="selectedOption">Select</div><ul>
<li class="selected-option" data-value="">{{ option.placeholder ?: option.name }} </li>
{% for detail in option.details %}<li class="{{ detail.is_out ? 'disabled' : '' }}" data-value="{{ detail.id }}" data-price="{{ detail.additional_price }}"> {{ detail.name }} {% if detail.additional_price > 0 %}&nbsp;<span class="text-color-primary">(</span> <span>+</span> <span class="text-color-primary" data-palace-money="{{ detail.additional_price }}" data-small data-fixed></span> <span class="text-color-primary">)</span>{% endif %}</li>{% endfor %}
</ul></div>
</div></div></div>
<div class="custom-field-separator"></div>
{% else %}
<div id="product-custom-user-input-fields"><div class="form-group"><label><span><span class="text-color-primary">{{ option.name }} </span></span></label>
{% if option.type == 'textarea' %}<textarea class="form-control" name="options[{{ option.id }}]" placeholder="{{ option.placeholder }}" {{ option.required ? 'required' : '' }}></textarea>{% else %}<input class="form-control" type="{{ option.type in ['number', 'date', 'time'] ? option.type : (option.type == 'datetime' ? 'datetime-local' : 'text') }}" name="options[{{ option.id }}]" placeholder="{{ option.placeholder }}" {{ option.required ? 'required' : '' }}>{% endif %}
</div></div>
<div class="custom-field-separator"></div>
{% endif %}
{% endfor %}
</div></div>
{% endif %}

<div class="salla-island"><salla-installment price="{{ product.price }}"></salla-installment>
{% if product.has_metadata %}<salla-metadata></salla-metadata>{% endif %}</div>
{% hook 'product:single.description' %}

<div class="all-product-btns ">
<div class="detail-extralink mb-10 mt-20 checkout-buttons {{ product.is_out_of_stock ? 'd-none' : '' }}">{{ buttons|raw }}</div>
</div>
{% if product.is_giftable %}<div class="salla-island"><salla-gifting class="mt-5 block" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : '' }}></salla-gifting></div>{% endif %}
{% if product.is_out_of_stock %}
<div class="section-out-of-stock-notify-me mb-3">
<h4 class="notify_me">{{ trans('palace.notify_me_title') }}</h4>
<div><p class=""><span class="txt_add cr fs__16">{{ trans('palace.out_of_stock') }}</span></p>
{% if product.notify_availability %}<div class="form-group form-notify-me"><div class="input-group-prepend"><button type="button" class="button w__100 button_primary btn-send-notify d-flex" data-palace-notify="{{ product.id }}">{{ trans('palace.send') }}</button></div></div>{% endif %}
</div></div>
{% endif %}

{% if product.sku %}<div class="font-xs single-product-extra-info"><ul class="mr-50 float-start"><li class="mb-5">{{ trans('palace.sku') }}: <span class="text-brand" id="product_sku">{{ product.sku }}</span></li></ul></div>{% endif %}
<div class="social-share flex tc product-share-wrapper">
<span class="color_primary fwb info-title">{{ trans('palace.share_product') }}</span>
<div class="text-left at-share-btn-elements kalles-social-media d-block fs__0 lh__1">
<a href="https://www.facebook.com/sharer/sharer.php?u={{ product.url|url_encode }}" target="_blank" rel="noopener" class="at-icon-wrapper at-share-btn at-svc-facebook kalles-social-media__btn"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="at-icon at-icon-facebook"> <g> <path d="M22 5.16c-.406-.054-1.806-.16-3.43-.16-3.4 0-5.733 1.825-5.733 5.17v2.882H9v3.913h3.837V27h4.604V16.965h3.823l.587-3.913h-4.41v-2.5c0-1.123.347-1.903 2.198-1.903H22V5.16z" fill-rule="evenodd"></path> </g> </svg></a>
<a href="https://twitter.com/intent/tweet?url={{ product.url|url_encode }}" target="_blank" rel="noopener" class="at-icon-wrapper at-share-btn at-svc-twitter kalles-social-media__btn"><svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 300 300.3"> <path class="st0" d="M174.3,134.3l93.1-106h-22.1l-80.9,92l-64.5-92H25.4l97.6,139.1L25.4,278.6h22.1l85.3-97.2l68.2,97.2h74.5 M55.5,44.7h33.9l156,218.5h-33.9"></path> </svg></a>
<a href="mailto:?body={{ product.url|url_encode }}" class="at-icon-wrapper at-share-btn at-svc-email kalles-social-media__btn"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="at-icon at-icon-email "> <g> <g fill-rule="evenodd"></g> <path d="M27 22.757c0 1.24-.988 2.243-2.19 2.243H7.19C5.98 25 5 23.994 5 22.757V13.67c0-.556.39-.773.855-.496l8.78 5.238c.782.467 1.95.467 2.73 0l8.78-5.238c.472-.28.855-.063.855.495v9.087z"></path> <path d="M27 9.243C27 8.006 26.02 7 24.81 7H7.19C5.988 7 5 8.004 5 9.243v.465c0 .554.385 1.232.857 1.514l9.61 5.733c.267.16.8.16 1.067 0l9.61-5.733c.473-.283.856-.96.856-1.514v-.465z"></path> </g> </svg></a>
<a href="https://pinterest.com/pin/create/button/?url={{ product.url|url_encode }}" target="_blank" rel="noopener" class="at-icon-wrapper at-share-btn at-svc-pinterest_share kalles-social-media__btn"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="at-icon at-icon-pinterest_share"> <g> <path d="M7 13.252c0 1.81.772 4.45 2.895 5.045.074.014.178.04.252.04.49 0 .772-1.27.772-1.63 0-.428-1.174-1.34-1.174-3.123 0-3.705 3.028-6.33 6.947-6.33 3.37 0 5.863 1.782 5.863 5.058 0 2.446-1.054 7.035-4.468 7.035-1.232 0-2.286-.83-2.286-2.018 0-1.742 1.307-3.43 1.307-5.225 0-1.092-.67-1.977-1.916-1.977-1.692 0-2.732 1.77-2.732 3.165 0 .774.104 1.63.476 2.336-.683 2.736-2.08 6.814-2.08 9.633 0 .87.135 1.728.224 2.6l.134.137.207-.07c2.494-3.178 2.405-3.8 3.533-7.96.61 1.077 2.182 1.658 3.43 1.658 5.254 0 7.614-4.77 7.614-9.067C26 7.987 21.755 5 17.094 5 12.017 5 7 8.15 7 13.252z" fill-rule="evenodd"></path> </g> </svg></a>
<a href="#" class="at-icon-wrapper at-share-btn at-svc-pinterest_share kalles-social-media__btn" data-palace-share="{{ product.url }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24px" height="24px"> <path d="M 18 2 A 3 3 0 0 0 15 5 A 3 3 0 0 0 15.054688 5.5605469 L 7.9394531 9.7109375 A 3 3 0 0 0 6 9 A 3 3 0 0 0 3 12 A 3 3 0 0 0 6 15 A 3 3 0 0 0 7.9355469 14.287109 L 15.054688 18.439453 A 3 3 0 0 0 15 19 A 3 3 0 0 0 18 22 A 3 3 0 0 0 21 19 A 3 3 0 0 0 18 16 A 3 3 0 0 0 16.0625 16.712891 L 8.9453125 12.560547 A 3 3 0 0 0 9 12 A 3 3 0 0 0 8.9453125 11.439453 L 16.060547 7.2890625 A 3 3 0 0 0 18 8 A 3 3 0 0 0 21 5 A 3 3 0 0 0 18 2 z"></path></svg></a>
</div>
</div>
<ul class="single-product-product-features">
{% for feature in [['feature-exchange.png', trans('palace.feature_exchange')], ['feature-original.png', trans('palace.feature_original')], ['feature-delivery.png', trans('palace.feature_delivery')]] %}
<li><img class="lazyload" src="{{ 'images/palace/lazyloading_img.svg'|asset }}" data-src="{{ ('images/palace/' ~ feature[0])|asset }}" alt="{{ feature[1] }}"><p>{{ feature[1] }}</p></li>
{% endfor %}
</ul>
{% hook 'product:single.description.end' %}
<div class="salla-island"><salla-quick-order class="mt-5 block"></salla-quick-order></div>
</div>
</div>
</div>
{% if not product.is_out_of_stock %}<div class="all-product-btns sticky-btn"><div class="detail-extralink mb-10 mt-20 checkout-buttons ">{{ buttons|raw }}</div></div>{% endif %}
{% hook 'product:single.form.end' %}
</form>

{#
    Hook: product.single.before_customer_reviews
    Fires before the customer reviews section (the description / reviews / questions tabs).
#}
<div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>

<div class="product-info">
<div class="tab-style3">
<ul class="nav nav-tabs text-uppercase" id="product-tabs">
<li class="nav-item"><a class="nav-link active" id="Description-tab" href="#Description" data-palace-tab-link>{{ trans('palace.description') }}</a></li>
<li class="nav-item"><a class="nav-link" id="Reviews-tab" href="#Reviews" data-palace-tab-link>{{ trans('palace.reviews') }}</a></li>
<li class="nav-item"><a class="nav-link" id="Questions-tab" href="#Questions" data-palace-tab-link>{{ trans('palace.questions') }}</a></li>
</ul>
<div class="tab-content shop_info_tab entry-main-content product-full-description-wrapper">
<div class="tab-pane fade show active" id="Description"><pre>{{ product.description|raw }}</pre></div>
<div class="tab-pane fade" id="Reviews">
<div class="comments-area"><div class="row">
<div class="col-lg-8"><h4 class="mb-30">{{ trans('palace.reviews') }}</h4><div class="comment-list first-reviews" data-palace-reviews="{{ product.id }}"></div><div class="pagination-custom"></div></div>
<div class="col-lg-4"><div class="ratings-sammary">
<h4 class="mb-30">{{ stars >= 4 ? trans('palace.rating_good') : (stars > 0 ? trans('palace.rating_ok') : trans('palace.rating_none')) }}</h4>
<div class="d-flex mb-30"><div class="product-rate d-inline-block mr-15"><div class="product-rating" style="width: {{ stars * 20 }}%"></div></div><h6>{{ stars|number_format(1) }}</h6></div>
{% for n in [5, 4, 3, 2, 1] %}<div class="progress {{ n == 1 ? 'mb-30' : '' }}"><span>{{ n }} star</span><div class="progress-bar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" data-palace-stars="{{ n }}"></div></div>{% endfor %}
</div></div>
</div></div>
</div>
<div class="tab-pane fade" id="Questions">
<div class="comments-area"><div class="row">
<div class="col-lg-8"><h4 class="mb-30">{{ trans('palace.questions') }}</h4><div class="Questions-content" data-palace-comments="{{ product.id }}"></div><div class="Questions-pagination-custom"></div></div>
<div class="col-lg-4"><div class="question-form"><h4 class="mb-15">{{ trans('palace.add_question') }}</h4>
<form class="form-contact comment_form" data-palace-comment-form="{{ product.id }}"><div class="row"><div class="col-12">
<div class="form-group"><textarea class="form-control w-100 " name="comment" cols="30" rows="9" placeholder="{{ trans('palace.question_placeholder') }}" required></textarea></div>
</div></div><div class="form-group"><button type="submit" class="button button-contactForm">{{ trans('palace.send') }}</button></div></form>
</div></div>
</div></div>
</div>
</div>
</div>
</div>
<div class="more-product-wrapper"></div>
</div>
</div></div></div>
</div>

<div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>
<div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}
