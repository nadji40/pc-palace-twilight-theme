{#
| Variable                                          | Type                | Description                                                    |
|---------------------------------------------------|---------------------|----------------------------------------------------------------|
| page                                              | object              |                                                                |
| page.title                                        | string              |                                                                |
| page.slug                                         | string              |                                                                |
| cart                                              | Cart                |                                                                |
| cart.id                                           | string              | Unique string for current cart                                 |
| cart.is_require_shipping                          | bool                | Does one of cart items require shipping?                       |
| cart.has_shipping                                 | bool                | Does shipping company selected?                                |
| cart.real_shipping_cost                           | float               | Shipping cost can become free by an offer, coupon              |
| cart.sub_total                                    | float               | The sum of items price without shipping or other costs         |
| cart.discount                                     | float               | final discount                                                 |
| cart.coupon                                       | ?string             |                                                                |
| cart.total                                        | float               |                                                                |
| cart.tax_amount                                   | float               | Calculate Tax amount                                                               |
| cart.free_shipping_bar                            | ?object             |                                                                |
| cart.free_shipping_bar.minimum_amount             | float               | how much cart total should be to apply free shipping ex: 1000  |
| cart.free_shipping_bar.has_free_shipping          | bool                | true when `cart.free_shipping_bar.percent==100`                |
| cart.free_shipping_bar.percent                    | float               | `0 - 100`                                                      |
| cart.free_shipping_bar.remaining                  | float               | `830`                                                          |
| cart.items                                        | CartItem[]          |                                                                |
| cart.options                                      | CartOptions[]       | array of options                                               |
| cart.items[].id                                   | int                 |                                                                |
| cart.items[].is_hidden_quantity                   | bool                |                                                                |
| cart.items[].url                                  | string              | Product url                                                    |
| cart.items[].quantity                             | int                 |                                                                |
| cart.items[].type                                 | string              | product type                                                   |
| cart.items[].product_price                        | MoneyTaxable        |                                                                |
| cart.items[].price                                | Money\|MoneyTaxable |                                                                |
| cart.items[].total                                | Money               |                                                                |
| cart.items[].product_id                           | int                 |                                                                |
| cart.items[].notes                                | string              |                                                                |
| cart.items[].can_add_note                         | bool                |                                                                |
| cart.items[].can_upload_file                      | bool                |                                                                |
| cart.items[].is_available                         | bool                |                                                                |
| cart.items[].offer                                | ?object             |                                                                |
| cart.items[].offer.discount                       | float               |                                                                |
| cart.items[].offer.is_free                        | bool                |                                                                |
| cart.items[].offer.names                          | ?string             | ex: `Buy 3 and the 4th on us, National Day`                    |
| cart.items[].donation                             | ?object             |                                                                |
| cart.items[].attachments                          | ?array              |                                                                |
| cart.items[].attachments[].id                     | int                 | image id, to be attache with the formData                      |
| cart.items[].attachments[].url                    | string              | image url                                                      |
| cart.items[].attachments[].product_id             | int                 |                                                                |
| cart.items[].attachments[].item_id                | int                 |                                                                |
| cart.items[].attachments[].name                   | int                 | image file name                                                |
#}
{#
  PC Palace cart (reference: pcpalace-theme/pages/cart.html): item rows, coupon, totals and
  checkout on Salla's cart; quantity, removal and coupon go through salla.cart (palace-reference.js, cart()).
#}
{% extends "layouts.master" %}
{% block content %}
{% set count = 0 %}{% for item in cart.items %}{% set count = count + item.quantity %}{% endfor %}
<div class="palace-ref palace-cart" data-palace-section="cart">
{% include 'pages.partials.palace-breadcrumb' with {crumbs: [[trans('palace.cart')]]} %}
<div class="container mb-80 mt-50 template-cart cart-page-wrapper">
<div class="row">
<div class="mb-40 col-lg-8">
<h1 class="mb-10 heading-2">{{ trans('palace.cart') }}</h1>
{% if cart.items|length %}<div class="d-flex justify-content-between cart-details"><h6 class="text-body"><span class="text-brand" data-palace-cart-count>{{ count }}</span> {{ trans('palace.products') }}</h6></div>{% endif %}
</div>
<div class="mb-40 col-lg-4">
{% if cart.items|length and cart.free_shipping_bar %}
<div class="cart-discount-rule-wrapper free-shipping-rule-section text-center text-muted">
<div class="card card-progress"><div class="percent"><svg><circle cx="40" cy="40" r="37"></circle><circle cx="40" cy="40" r="37" style="--percent: {{ cart.free_shipping_bar.percent }}"></circle></svg><div class="number"><h3>{{ cart.free_shipping_bar.percent|round }}<span>%</span></h3></div></div></div>
<div class="d-flex align-items-center"><div class="message flex-grow-1 free-shipping-rule-message">{% if cart.free_shipping_bar.has_free_shipping %}{{ trans('palace.free_shipping_done') }}{% else %}{{ trans('palace.free_shipping_remaining') }} <span data-palace-money="{{ cart.free_shipping_bar.remaining }}" data-small></span>{% endif %}</div></div>
</div>
{% endif %}
</div>
</div>

{% if cart.items|length %}
<div class="row cart-details">
<div class="col-lg-8">
{% hook 'cart:items.start' %}
<div class="salla-island palace-island-gap"><salla-conditional-offer></salla-conditional-offer></div>
<div class="salla-island palace-island-gap"><salla-offer></salla-offer></div>
<div class="table-responsive shopping-summery"><div class="table-content">
<div class="cart_header"><div class="row al_center"><div class="col-7">{{ trans('palace.product') }}</div><div class="text-center col-2">{{ trans('palace.quantity') }}</div><div class="text-center col-3">{{ trans('palace.price') }}</div></div></div>
<div class="cart_items js_cat_items template_for_cart_products_list">
{% for item in cart.items %}
{# Prices are Money objects: formatted with Salla's money filter, as in Raed (their fields are not read directly). #}
{% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
<div class="cart-product-row-wrapper" data-palace-cart-item="{{ item.id }}">
{# Salla updates an item with options only when the options are sent again (Raed wraps each item in a form
   with its options): the form carries the id, the chosen options and Salla's quantity input. #}
{% set free_text_options = false %}{% for option in item.options %}{% if not option.details|length %}{% set free_text_options = true %}{% endif %}{% endfor %}
<form class="cart-product-row" data-palace-cart-form="{{ item.id }}" onsubmit="return false">
<input type="hidden" name="id" value="{{ item.id }}">
{% if not free_text_options %}{% for option in item.options %}{% for detail in option.details %}{% if detail.is_selected %}<input type="hidden" name="options[{{ option.id }}]{{ option.type in ['multiple-option', 'multiple-options', 'multi-options', 'checkbox'] ? '[]' : '' }}" value="{{ detail.id }}">{% endif %}{% endfor %}{% endfor %}{% endif %}
<div class="cart-product-delete"><a href="#" data-palace-remove="{{ item.id }}" aria-label="{{ trans('palace.remove') }}"><span class="icon-delete"></span></a></div>
<div class="cart-product-col-img"><a class="cart-product-image-link" href="{{ item.url }}"><img class="cart-product-image lazyload" src="{{ 'images/palace/lazyloading_img.svg'|asset }}" data-src="{{ item.product_image }}" alt="{{ item.product_name }}"></a></div>
<div class="cart-product-col-details">
<div class="product-title-row"><h1><a class="cart-product-image-link" href="{{ item.url }}">{{ item.product_name }}</a></h1></div>
{# Chosen options: Salla gives each option its details, the chosen ones marked is_selected (there is no option.value). #}
{% if item.options|length and not free_text_options %}<div class="custom-options-summary">{% for option in item.options %}{% set chosen = [] %}{% for detail in option.details %}{% if detail.is_selected %}{% set chosen = chosen|merge([detail.name]) %}{% endif %}{% endfor %}{% if chosen|length %}<p class="cart_meta_variant">{{ option.name }}: {{ chosen|join('، ') }}</p>{% endif %}{% endfor %}</div>{% endif %}
{% if item.offer and item.offer.names and not item.detailed_offers %}<div class="cart-product-discount-messages"><span class="message">{{ item.offer.names }}</span></div>{% endif %}
<div class="salla-island"><salla-cart-item-offers quantity="{{ item.quantity }}" item-id="{{ item.id }}" product-price="{{ item.product_price }}" offers="{{ item.detailed_offers|json_encode }}"></salla-cart-item-offers></div>
{% if free_text_options %}<div class="salla-island palace-options palace-cart-options">{% include 'pages.partials.product.options' with {product: item} %}</div>{% endif %}
{% if item.is_available is same as(false) %}<p class="text-danger font-xs">{{ trans('palace.out_of_stock') }}</p>{% endif %}
</div>
<div class="cart-products-action"><div class="cart-product-quantity-dropdown form-group"><div>
<div class="salla-island palace-cart-qty"><salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}" value="{{ item.quantity }}" name="quantity" aria-label="{{ trans('palace.quantity') }}" {{ item.is_hidden_quantity ? 'disabled' : '' }}></salla-quantity-input></div>
</div></div></div>
<div class="cart-product-prices">
<div class="totals"><span class="cart-product-total-price" data-palace-item-total="{{ item.id }}">{{ item.is_available ? item_total : trans('palace.out_of_stock') }}</span></div>
<div class="cart-product-price-each {{ item.quantity > 1 ? 'd-block' : 'd-none' }}" data-palace-item-each="{{ item.id }}"><span>{{ trans('palace.per_item') }}</span> <span>{{ item.price|money }}</span></div>
</div>
</form>
</div>
{% endfor %}
</div>
</div></div>
<a href="{{ store.url }}" class="cart-continue-shopping"><i class="fi-rs-arrow-left"></i> {{ trans('palace.continue_shopping') }}</a>
<div class="divider-2 mb-30"></div>
{% hook 'cart:items.end' %}
</div>
{% hook 'cart:summary.start' %}
<div class="col-lg-4">
<div class="border p-md-4 cart-totals ml-30">
<div class="salla-island palace-cart-summary">
{% if loyalty %}<salla-loyalty-panel prize-points="{{ loyalty.prize.points }}" prize-title="{{ loyalty.prize.title }}"></salla-loyalty-panel>{% endif %}
<div id="cart-gifting" class="palace-cart-block {{ gift.enabled ? '' : 'hidden' }}"><salla-gifting id="salla-gifting" widget-title="{{ trans('pages.cart.gift_widget_title') }}" widget-subtitle="{{ gift.text }}" {{ gift.type }}-products vertical></salla-gifting></div>
{% if store.settings.cart.apply_coupon_enabled %}
<div class="palace-cart-block">{% hook 'cart:coupon.start' %}<salla-cart-coupons></salla-cart-coupons>{% hook 'cart:coupon.end' %}</div>
{% endif %}
{% hook 'cart:summary-card.start' %}
<salla-cart-summary-card></salla-cart-summary-card>
{% hook 'cart:summary-card.end' %}
{% hook 'cart:summary.end' %}
<salla-tiered-offer></salla-tiered-offer>
<salla-installment price="{{ cart.total }}"></salla-installment>
</div>
</div>
</div>
</div>
{% endif %}

<div class="cart-action cart-empty {{ cart.items|length ? 'd-none' : '' }}" data-palace-cart-empty>
{% include 'pages.partials.palace-cart-empty' %}
<h4 class="mb-30">{{ trans('palace.cart_empty') }}</h4>
<a href="{{ store.url }}" class="btn" style="margin-bottom: 16px;"><i class="mr-10 fi-rs-arrow-left"></i> {{ trans('palace.continue_shopping') }}</a>
</div>
</div>
</div>
{% endblock %}
