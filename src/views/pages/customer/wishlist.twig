{#
  PC Palace wishlist: the customer's wishlist products in the PC Palace card grid.
#}
{% extends "layouts.customer" %}
{% block inner_content %}
{% hook 'customer:wishlist.items.start' %}
<div class="palace-wishlist" data-palace-section="listing" data-palace-listing="{{ {'source': 'wishlist', 'value': null, 'limit': 24}|json_encode }}">
<div class="row product-grid" id="category_more_wrapper"></div>
<button id="load-more-button" class="btn primary-btn mt-[25px] mx-auto block" type="button" hidden>{{ trans('palace.more') }}</button>
</div>
{% hook 'customer:wishlist.items.end' %}
{% endblock %}
