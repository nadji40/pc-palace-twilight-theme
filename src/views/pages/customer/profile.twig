{#
  PC Palace profile form. Saved through Salla (salla.form.onSubmit 'profile.update');
  the phone input, verification and notification settings stay Salla components.
#}
{% extends "layouts.customer" %}
{% block inner_content %}
<p class="mb-30">{{ trans('palace.profile_intro') }}</p>
{% hook 'customer:profile.form.start' %}
<form method="post" class="palace-profile-form" onsubmit="return salla.form.onSubmit('profile.update', event)">
<div class="row">
{% hook 'customer:profile.form.fields.start' %}
<div class="form-group col-md-6"><label>{{ trans('pages.profile.first_name') }} <span class="required">*</span></label><input required class="form-control" name="first_name" type="text" value="{{ user.first_name }}"></div>
<div class="form-group col-md-6"><label>{{ trans('pages.profile.last_name') }} <span class="required">*</span></label><input required class="form-control" name="last_name" type="text" value="{{ user.last_name }}"></div>
<div class="form-group col-md-6"><label>{{ trans('pages.profile.birthday') }}</label><input class="form-control" name="birthday" type="date" value="{{ user.birthday }}"></div>
<div class="form-group col-md-6"><label>{{ trans('pages.profile.gender') }}</label><select class="form-control" name="gender"><option value="">{{ trans('pages.profile.gender_placeholder') }}</option><option value="male" {{ user.gender == 'male' ? 'selected' : '' }}>{{ trans('pages.profile.male') }}</option><option value="female" {{ user.gender == 'female' ? 'selected' : '' }}>{{ trans('pages.profile.female') }}</option></select></div>
<div class="form-group col-md-6"><label>{{ trans('common.elements.email') }} <span class="required">*</span></label><input required class="form-control" name="email" type="email" value="{{ user.email }}"></div>
<div class="form-group col-md-6"><label>{{ trans('common.elements.mobile') }}</label><div class="salla-island"><salla-tel-input phone="{{ user.mobile }}"></salla-tel-input></div></div>
{% for field in custom_fields %}
<div class="form-group col-md-6"><label>{{ field.label }} {% if field.required %}<span class="required">*</span>{% endif %}</label><input class="form-control" type="text" name="custom_fields[{{ field.id }}]" value="{{ field.value }}" {{ field.required ? 'required' : '' }}></div>
{% endfor %}
{% hook 'customer:profile.form.fields.end' %}
{% hook 'customer:profile.form.submit.start' %}
<div class="col-md-12"><button type="submit" class="btn btn-fill-out submit font-weight-bold" name="submit">{{ trans('common.elements.save') }}</button></div>
{% hook 'customer:profile.form.submit.end' %}
</div>
</form>
{% hook 'customer:profile.form.end' %}
<div class="salla-island palace-island-top"><salla-verify></salla-verify><salla-user-settings {{ user.is_notifiable ? 'is-notifiable' : '' }} class="mt-10 block"></salla-user-settings></div>
{% endblock %}
