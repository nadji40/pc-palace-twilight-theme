{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.url     | string                |             |
| page.slug    | string                |             |
| page.type    | string                |             |

  PC Palace content page (reference: pcpalace-theme/pages/partners.html).
#}
{% extends "layouts.master" %}
{% block content %}
<div class="palace-ref palace-page">
{% include 'pages.partials.palace-breadcrumb' with {crumbs: [[page.title]]} %}
<div class="page-content pt-50"><div class="container">
<div class="single-page pr-30 mb-lg-0 mb-sm-5">
<div class="single-header style-2"><h2>{{ page.title }}</h2></div>
<div class="single-content-page mb-50"><pre>{{ page.content|raw }}</pre></div>
</div>
</div></div>
</div>
{% endblock %}
