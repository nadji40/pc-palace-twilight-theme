{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.url     | string                |             |
| page.slug    | string                |             |
| page.type    | string                |             |

  PC Palace content page (reference: pcpalace-theme/pages/partners.html).
#}
{% extends "layouts.master" %}
{% block content %}
{% if page.type == 'customised' %}
{#
    Hook: information_page.information_page
    A page built with Salla's page builder: its blocks are rendered by this hook.
#}
<div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
{% else %}
<div class="palace-ref palace-page">
{% include 'pages.partials.palace-breadcrumb' with {crumbs: [[page.title]]} %}
<div class="page-content pt-50"><div class="container">
<div class="single-page pr-30 mb-lg-0 mb-sm-5">
<div class="single-header style-2"><h2>{{ page.title }}</h2></div>
<div class="single-content-page mb-50"><pre>{{ page.content|raw }}</pre></div>
<div class="salla-island palace-island-top"><salla-comments item-id="{{ page.id }}" type="page"></salla-comments></div>
</div>
</div></div>
</div>
{% endif %}
{% endblock %}
