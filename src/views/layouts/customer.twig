{#
  PC Palace customer account layout (Nest dashboard: side menu + card).
  Pages extend it and fill `inner_content` (and optionally `inner_title`).
#}
{% extends "layouts.master" %}
{% block content %}
{# Each entry: page slug (for is_page), path (link() appends it to the store address), title, icon. #}
{% set account_links = [
  ['customer.profile', 'profile', trans('palace.profile'), 'fi-rs-user'],
  ['customer.orders', 'orders', trans('palace.orders'), 'fi-rs-shopping-bag'],
  ['customer.wishlist', 'wishlist', trans('palace.wishlist'), 'fi-rs-heart'],
  ['customer.notifications', 'notifications', trans('palace.notifications'), 'fi-rs-bell']
] %}
{% if user.can_access_wallet %}{% set account_links = account_links|merge([['customer.wallet', 'wallet', trans('palace.wallet'), 'fi-rs-label']]) %}{% endif %}
<div class="palace-ref palace-account">
{% include 'pages.partials.palace-breadcrumb' with {crumbs: [[trans('palace.my_account'), link('profile')], [page.title]]} %}
<div class="page-content pt-50 pb-80"><div class="container"><div class="row"><div class="col-lg-11 m-auto"><div class="row">
<div class="col-md-3">
<div class="palace-account__hello mb-20"><span class="palace-account__avatar">{% if user.avatar %}<img src="{{ user.avatar }}" alt="">{% else %}<i class="fi-rs-user"></i>{% endif %}</span><div><h6>{{ trans('palace.hello') }} {{ user.first_name }}</h6><p class="font-xs text-muted">{{ user.email ?: user.mobile }}</p></div></div>
<div class="dashboard-menu"><ul class="nav flex-column" role="tablist">
{% for item in account_links %}
<li class="nav-item"><a class="nav-link {{ is_page(item[0]) ? 'active' : '' }}" href="{{ link(item[1]) }}"><i class="{{ item[3] }} mr-10"></i>{{ item[2] }}</a></li>
{% endfor %}
<li class="nav-item"><a class="nav-link" href="#" data-palace-logout><i class="fi-rs-sign-out mr-10"></i>{{ trans('palace.logout') }}</a></li>
</ul></div>
</div>
<div class="col-md-9"><div class="tab-content account dashboard-content pl-50"><div class="tab-pane fade active show" role="tabpanel">
<div class="card">
<div class="card-header"><h3 class="mb-0">{% block inner_title %}{{ page.title }}{% endblock %}</h3></div>
<div class="card-body">{% block inner_content %}{% endblock %}</div>
</div>
</div></div></div>
</div></div></div></div></div>
</div>
{% endblock %}
